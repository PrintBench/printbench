{
  "permissions": {
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.github/workflows/**)",
      "Edit(/AGENTS.md)",
      "Edit(/docs/testing.md)",
      "Edit(/playwright.config.ts)",
      "Edit(/scripts/test-map/**)",
      "Edit(/tests/scenarios/**)",
      "Edit(/vitest.config.ts)",
      "Bash(gh api *labels*)",
      "Bash(gh label *)",
      "Bash(gh pr create *--label*)",
      "Bash(gh pr edit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/tsx/dist/cli.mjs",
              "${CLAUDE_PROJECT_DIR}/scripts/test-map/hook.mts"
            ]
          }
        ]
      }
    ]
  }
}
