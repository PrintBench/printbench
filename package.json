{
  "name": "printbench",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted web app for managing and finding your 3D print files (STL, 3MF, OBJ, PLY). Postgres is the only dependency.",
  "keywords": [
    "3d-printing",
    "stl",
    "3mf",
    "self-hosted",
    "model-library",
    "nextjs",
    "postgres",
    "3d-models"
  ],
  "homepage": "https://github.com/OWNER/printbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/printbench.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/printbench/issues"
  },
  "author": "Owl Media",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "npm run dev -w @pb/web",
    "dev:worker": "npm run dev -w @pb/worker",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "npm run generate -w @pb/db",
    "db:migrate": "npm run migrate -w @pb/db",
    "build": "npm run build -w @pb/web && npm run build -w @pb/worker",
    "typecheck": "tsc --build && npm run typecheck -w @pb/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:phase1": "tsx scripts/verify-phase1.mts",
    "auth:schema": "tsx scripts/introspect-auth-schema.mts",
    "verify:phase2": "tsx scripts/verify-phase2.mts",
    "verify:phase2:ui": "tsx scripts/verify-phase2-ui.mts",
    "verify:phase3": "tsx scripts/verify-phase3.mts",
    "verify:phase4": "tsx scripts/verify-phase4.mts",
    "verify:phase5": "tsx scripts/verify-phase5.mts",
    "verify:phase6": "tsx scripts/verify-phase6.mts",
    "verify:phase7": "tsx scripts/verify-phase7.mts",
    "verify:phase8": "tsx scripts/verify-phase8.mts",
    "verify:s3": "tsx scripts/verify-s3.mts",
    "backup": "tsx scripts/backup.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
