# ---- Core ----------------------------------------------------------------
NODE_ENV=development
# Public URL the app is served from. Used for auth callbacks and signed links.
APP_URL=http://localhost:3000

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgres://printmanager:printmanager@localhost:5433/printmanager

# ---- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ---- File delivery -------------------------------------------------------
# stream    = Node streams the bytes (dev only; simple, no proxy needed)
# xaccel    = hand off to nginx via X-Accel-Redirect (production, local/NAS storage)
# presigned = redirect to a presigned S3 URL (production, S3 storage)
FILE_DELIVERY=stream

# Where generated thumbnails and derived assets are written.
DATA_DIR=./data

# ---- Worker --------------------------------------------------------------
# Concurrency for the CPU-bound render/analyse pool. Defaults to cpus-1.
# RENDER_CONCURRENCY=3
