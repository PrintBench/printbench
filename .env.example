# Copy this file to .env, then set POSTGRES_PASSWORD and BETTER_AUTH_SECRET.
# Everything else has a working default for both `docker compose up` and
# local development.
#
# Docker reads only the keys under "Secrets", "Your library" and "Docker
# stack" — compose interpolates those into the containers. The keys under
# "Local development" are read by the app itself when you run it outside
# Docker, and the containers never see them.

# ---- Secrets -------------------------------------------------------------
# Password for the bundled Postgres. No default on purpose: compose refuses
# to start until you set one.
POSTGRES_PASSWORD=

# Signs sessions and the links the app hands out. No default either: a
# placeholder here would ship as a shared, publicly-known signing key on
# every install that skipped this step. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Your library --------------------------------------------------------
# The folder holding your print files. Mounted read-only — the app indexes
# it and never moves, renames or deletes anything in it.
LIBRARY_PATH=./libraries

# ---- Docker stack --------------------------------------------------------
# Port published by docker-compose.local.yml. Coolify does not publish this
# port; Traefik proxies to nginx's internal port 80 instead.
PORT=8080

POSTGRES_USER=printbench
POSTGRES_DB=printbench

# Public URL the app is served from. Used for auth callbacks and signed
# links. Leave unset and it follows PORT above; set it to your real origin
# (https://prints.example.com) when you put a domain in front.
# APP_URL=

# stream    = Node streams the bytes (dev only; simple, no proxy needed)
# xaccel    = hand off to nginx via X-Accel-Redirect (production, local/NAS storage)
# presigned = redirect to a presigned S3 URL (production, S3 storage)
# Leave unset: that means xaccel under Docker and stream when running
# locally, which is the right answer in both cases.
# FILE_DELIVERY=

# ---- Local development ---------------------------------------------------
# Ignored by Docker; compose sets its own values on the containers.
NODE_ENV=development

# Matches `npm run db:up`. The test suite reads this too — without it the
# database-backed third of the suite cannot run, and a green result proves
# much less than it appears to.
DATABASE_URL=postgres://printbench:printbench@localhost:5433/printbench

# Where generated thumbnails and derived assets are written.
DATA_DIR=./data

# Concurrency for the CPU-bound render/analyse pool. Defaults to cpus-1.
# RENDER_CONCURRENCY=3

# Where an admin may point a library, separated by the platform path separator
# (: on Linux/macOS, ; on Windows). Confines the folder picker in the UI.
# Unset in development means the repository, which is what makes the demo
# library visible without configuration.
# LIBRARY_ROOTS=

# Where "somewhere to upload to" libraries are created. Must be writable.
# Defaults to <DATA_DIR>/libraries.
# MANAGED_LIBRARY_ROOT=
